# IZZZI Docker Swarm Stack - Generated by Ansible
# Environment: {{ environment }}
# Domain: {{ domain }}

version: "3.9"

services:
  # ============================================
  # TRAEFIK - Reverse Proxy & Load Balancer
  # ============================================
  traefik:
    image: traefik:v3.3
    command:
      - "--api.dashboard=true"
      - "--api.insecure=false"
      - "--providers.swarm=true"
      - "--providers.swarm.exposedbydefault=false"
      - "--providers.swarm.network=izzzi_izzzi-network"
      - "--providers.swarm.endpoint=unix:///var/run/docker.sock"
      - "--entrypoints.web.address=:80"
      - "--entrypoints.websecure.address=:443"
      - "--entrypoints.web.http.redirections.entrypoint.to=websecure"
      - "--entrypoints.web.http.redirections.entrypoint.scheme=https"
      - "--certificatesresolvers.letsencrypt.acme.httpchallenge=true"
      - "--certificatesresolvers.letsencrypt.acme.httpchallenge.entrypoint=web"
      - "--certificatesresolvers.letsencrypt.acme.email=admin@{{ domain }}"
      - "--certificatesresolvers.letsencrypt.acme.storage=/letsencrypt/acme.json"
      - "--log.level=DEBUG"
      - "--accesslog=true"
    ports:
      - target: 80
        published: 80
        protocol: tcp
        mode: host
      - target: 443
        published: 443
        protocol: tcp
        mode: host
    volumes:
      - /var/run/docker.sock:/var/run/docker.sock:ro
      - traefik_letsencrypt:/letsencrypt
    networks:
      - izzzi-network
    deploy:
      mode: replicated
      replicas: 1
      placement:
        constraints:
          - node.role == manager
      labels:
        - "traefik.enable=true"
        - "traefik.http.routers.traefik.rule=Host(`traefik.{{ domain }}`)"
        - "traefik.http.routers.traefik.entrypoints=websecure"
        - "traefik.http.routers.traefik.tls.certresolver=letsencrypt"
        - "traefik.http.routers.traefik.service=api@internal"
        - "traefik.http.services.traefik.loadbalancer.server.port=8080"
        - "traefik.http.routers.traefik.middlewares=traefik-auth"
        - "traefik.http.middlewares.traefik-auth.basicauth.users={{ lookup('env', 'TRAEFIK_DASHBOARD_AUTH') | default('admin:$apr1$xyz', true) }}"
      restart_policy:
        condition: on-failure
        delay: 5s
        max_attempts: 3
      resources:
        limits:
          cpus: "0.50"
          memory: 256M
        reservations:
          cpus: "0.25"
          memory: 128M

  # ============================================
  # POSTGRESQL - Single Database with pgvector
  # ============================================
  postgres:
    image: pgvector/pgvector:pg18
    environment:
      # POSTGRES_USER_FILE: /run/secrets/db_user
      # POSTGRES_PASSWORD_FILE: /run/secrets/db_password
      POSTGRES_USER: {{ lookup('env', 'DB_USER') | default('izzzi_admin', true) }}
      POSTGRES_PASSWORD: {{ lookup('env', 'DB_PASSWORD') | default('Nadmer12,12!', true) }}
      POSTGRES_DB: {{ database_name }}
      PGDATA: /var/lib/postgresql/data/pgdata
    # secrets:
    #   - db_user
    #   - db_password
    volumes:
      - postgres_data:/var/lib/postgresql/data
    networks:
      - izzzi-network
    deploy:
      mode: replicated
      replicas: 1
      placement:
        constraints:
          - node.labels.db == true
      restart_policy:
        condition: on-failure
        delay: 5s
        max_attempts: 3
      resources:
        limits:
          cpus: "2.0"
          memory: 1G
        reservations:
          cpus: "0.5"
          memory: 512M
    healthcheck:
      test:
        [
          "CMD-SHELL",
          "pg_isready -U {{ lookup('env', 'DB_USER') | default('izzzi_admin', true) }} -d {{ database_name }}",
        ]
      interval: 10s
      timeout: 5s
      retries: 5

  # ============================================
  # REDIS - Cache & Celery Broker
  # ============================================
  redis:
    image: redis:7-alpine
    command: >
      redis-server
      --appendonly yes
      --maxmemory 256mb
      --maxmemory-policy allkeys-lru
      --save 60 1000
      --save 300 10
    volumes:
      - redis_data:/data
    networks:
      - izzzi-network
    deploy:
      mode: replicated
      replicas: 1
      placement:
        constraints:
          - node.labels.db == true
      restart_policy:
        condition: on-failure
        delay: 5s
        max_attempts: 3
      resources:
        limits:
          cpus: "0.50"
          memory: 384M
        reservations:
          cpus: "0.25"
          memory: 256M
    healthcheck:
      test: ["CMD", "redis-cli", "ping"]
      interval: 10s
      timeout: 3s
      retries: 5

  # ============================================
  # FRONTEND - Next.js Application
  # ============================================
  frontend:
    image: {{ docker_registry }}/izzzi:{{ image_tag | default('latest') }}
    environment:
      NODE_ENV: production
      NEXT_PUBLIC_API_BASE_URL: https://api.{{ domain }}/api
      NEXT_PUBLIC_AI_API_BASE_URL: https://ai.{{ domain }}/api/v1
      NEXT_PUBLIC_API_TIMEOUT: "30000"
      NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY: ${STRIPE_PUBLISHABLE_KEY}
      NEXT_PUBLIC_POSTHOG_KEY: ${POSTHOG_KEY}
      NEXT_PUBLIC_POSTHOG_HOST: ${POSTHOG_HOST:-https://app.posthog.com}
    networks:
      - izzzi-network
    deploy:
      mode: replicated
      replicas: 3
      update_config:
        parallelism: 1
        delay: 10s
        failure_action: rollback
        order: start-first
      rollback_config:
        parallelism: 1
        delay: 10s
      restart_policy:
        condition: on-failure
        delay: 5s
        max_attempts: 3
      labels:
        - "traefik.enable=true"
        - "traefik.http.routers.frontend.rule=Host(`{{ domain }}`) || Host(`www.{{ domain }}`)"
        - "traefik.http.routers.frontend.entrypoints=websecure"
        - "traefik.http.routers.frontend.tls.certresolver=letsencrypt"
        - "traefik.http.services.frontend.loadbalancer.server.port=3000"
        - "traefik.http.services.frontend.loadbalancer.sticky.cookie=true"
        - "traefik.http.services.frontend.loadbalancer.sticky.cookie.name=izzzi_frontend"
        - "traefik.http.services.frontend.loadbalancer.healthcheck.path=/"
        - "traefik.http.services.frontend.loadbalancer.healthcheck.interval=30s"
      resources:
        limits:
          cpus: "0.50"
          memory: 512M
        reservations:
          cpus: "0.25"
          memory: 256M
    healthcheck:
      test: ["CMD-SHELL", "node -e \"require('http').get('http://localhost:3000', (r) => {process.exit(r.statusCode === 200 ? 0 : 1)}).on('error', () => process.exit(1))\" || exit 1"]
      interval: 30s
      timeout: 10s
      retries: 3
      start_period: 40s

  # ============================================
  # BACKEND - NestJS API
  # ============================================
  backend:
    image: {{ docker_registry }}/izzzi-backend:{{ image_tag | default('latest') }}
    environment:
      NODE_ENV: production
      PORT: "3001"
      RUN_MIGRATIONS: "true"
      # Database - MUST match postgres service configuration
      # Using explicit values from Ansible to ensure they are passed correctly
      DATABASE_HOST: postgres
      DATABASE_PORT: "5432"
      DATABASE_NAME: {{ database_name }}
      DATABASE_USER: "{{ lookup('env', 'DB_USER') | default('izzzi_admin', true) }}"
      DATABASE_PASSWORD: "{{ lookup('env', 'DB_PASSWORD') | default('Nadmer12,12!', true) }}"
      # TypeORM connection string (alternative format)
      # Note: Password special characters must be URL-encoded in connection string
      {%- set db_user = lookup('env', 'DB_USER') | default('izzzi_admin', true) -%}
      {%- set db_password = lookup('env', 'DB_PASSWORD') | default('Nadmer12,12!', true) -%}
      {%- set db_password_encoded = db_password | replace(',', '%2C') | replace('!', '%21') -%}
      
      DATABASE_URL: "postgresql://{{ db_user }}:{{ db_password_encoded }}@postgres:5432/{{ database_name }}"
      # DATABASE_USER_FILE: /run/secrets/db_user
      # DATABASE_PASSWORD_FILE: /run/secrets/db_password
      # Redis (DB 0 for cache)
      REDIS_HOST: redis
      REDIS_PORT: "6379"
      REDIS_DB: "0"
      # JWT
      # AUTH_JWT_SECRET_FILE: /run/secrets/jwt_secret
      # AUTH_JWT_REFRESH_SECRET_FILE: /run/secrets/jwt_refresh_secret
      AUTH_JWT_SECRET: dGTTzsrUipsLtglTFe5a6yC43wrHYHSqUj3YCgBista9GQYXPaw0yvV4nLTF/1vN
      AUTH_JWT_REFRESH_SECRET: H1W+7qV3x58PI7lG+56gnMNsa7eNLWuLDH2S5RMlMmakcxD/OPegVUowxFQFj29r
      AUTH_JWT_EXPIRES_IN: "15m"
      AUTH_JWT_REFRESH_EXPIRES_IN: "7d"
      # AWS
      AWS_REGION: ${AWS_REGION:-eu-west-3}
      AWS_ACCESS_KEY_ID: ${AWS_ACCESS_KEY_ID:-DO007CPECYTU2UT9QBW3}
      AWS_SECRET_ACCESS_KEY: ${AWS_SECRET_ACCESS_KEY:-X7lHW1RuN0OuMMMfSPjQqskcNhCKIl8NHqjZ9e/DaEA}
      AWS_S3_BUCKET: ${AWS_S3_BUCKET:-izzzi-storage}
      AWS_COGNITO_USER_POOL_CLIENT_ID: ${AWS_COGNITO_USER_POOL_CLIENT_ID}
      # AWS_COGNITO_USER_POOL_CLIENT_SECRET_FILE: /run/secrets/cognito_client_secret
      AWS_COGNITO_USER_POOL_ID: ${AWS_COGNITO_USER_POOL_ID}
      # URLs
      FRONTEND_DOMAIN_URL: https://{{ domain }}
      # Google OAuth
      GOOGLE_CLIENT_ID: ${GOOGLE_CLIENT_ID}
      # GOOGLE_CLIENT_SECRET_FILE: /run/secrets/google_client_secret
      GOOGLE_CLIENT_SECRET: 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
      GOOGLE_CALLBACK_URL: https://api.{{ domain }}/api/auth/google/callback
      # Stripe
      # STRIPE_SECRET_KEY_FILE: /run/secrets/stripe_secret_key
      # STRIPE_WEBHOOK_SECRET_FILE: /run/secrets/stripe_webhook_secret
      STRIPE_SECRET_KEY: ${STRIPE_SECRET_KEY}
      STRIPE_WEBHOOK_SECRET: ${STRIPE_WEBHOOK_SECRET}
      STRIPE_PUBLISHABLE_KEY: ${STRIPE_PUBLISHABLE_KEY}
      # Email (Brevo)
      # BREVO_API_KEY_FILE: /run/secrets/brevo_api_key
      BREVO_API_KEY: ${BREVO_API_KEY}
      # AI Service
      AI_SERVICE_URL: http://ai-api:8000
    # secrets:
    #   - db_user
    #   - db_password
    #   - jwt_secret
    #   - jwt_refresh_secret
    #   - stripe_secret_key
    #   - stripe_webhook_secret
    #   - google_client_secret
    #   - brevo_api_key
    #   - aws_secret_access_key
    #   - cognito_client_secret
    networks:
      - izzzi-network
    deploy:
      mode: replicated
      replicas: 1
      update_config:
        parallelism: 1
        delay: 10s
        failure_action: rollback
        order: start-first
      rollback_config:
        parallelism: 1
        delay: 10s
      restart_policy:
        condition: on-failure
        delay: 5s
        max_attempts: 3
      labels:
        - "traefik.enable=true"
        - "traefik.http.routers.backend.rule=Host(`api.{{ domain }}`)"
        - "traefik.http.routers.backend.entrypoints=websecure"
        - "traefik.http.routers.backend.tls.certresolver=letsencrypt"
        - "traefik.http.services.backend.loadbalancer.server.port=3001"
        - "traefik.http.services.backend.loadbalancer.healthcheck.path=/api/health"
        - "traefik.http.services.backend.loadbalancer.healthcheck.interval=30s"
      resources:
        limits:
          cpus: "1.0"
          memory: 1G
        reservations:
          cpus: "0.5"
          memory: 512M
    healthcheck:
      test: ["CMD-SHELL", "node -e \"require('http').get('http://localhost:3001/api/health', (r) => {process.exit(r.statusCode === 200 ? 0 : 1)}).on('error', () => process.exit(1))\" || exit 1"]
      interval: 30s
      timeout: 10s
      retries: 5
      start_period: 90s

  # ============================================
  # AI API - FastAPI Service
  # ============================================
  ai-api:
    image: {{ docker_registry }}/izzzi-ai:{{ image_tag | default('latest') }}
    environment:
      ENVIRONMENT: production
      DEBUG: "true"
      LOG_LEVEL: ${LOG_LEVEL:-INFO}
      RUN_MIGRATIONS: "true"
      # Database - using DATABASE_URL format expected by the app
      # Note: Password is URL-encoded (comma=%2C, exclamation=%21)
      {% set db_user = lookup('env', 'DB_USER') | default('izzzi_admin', true) %}
      {% set db_password = lookup('env', 'DB_PASSWORD') | default('Nadmer12,12!', true) %}
      {% set db_password_encoded = db_password | replace(',', '%2C') | replace('!', '%21') %}
      
      DATABASE_URL: "postgresql+asyncpg://{{ db_user }}:{{ db_password_encoded }}@postgres:5432/{{ database_name }}"
      DATABASE_POOL_SIZE: "20"
      DATABASE_MAX_OVERFLOW: "10"
      # JWT (same secret as backend)
      JWT_SECRET: dGTTzsrUipsLtglTFe5a6yC43wrHYHSqUj3YCgBista9GQYXPaw0yvV4nLTF/1vN
      JWT_ALGORITHM: HS256
      # OpenAI
      OPENAI_API_KEY: {{ lookup('env', 'OPENAI_API_KEY') | default('sk-placeholder', true) }}
      OPENAI_MODEL: gpt-4-turbo-preview
      EMBEDDING_MODEL: text-embedding-3-small
      # Redis (DBs 1-3 for AI service)
      REDIS_URL: redis://redis:6379/1
      CELERY_BROKER_URL: redis://redis:6379/2
      CELERY_RESULT_BACKEND: redis://redis:6379/3
      # API Config
      API_V1_PREFIX: /api/v1
      CORS_ORIGINS: '["https://{{ domain }}","https://api.{{ domain }}"]'
      SERVICE_NAME: izzzi-ai-service
      SERVICE_PORT: "8000"
      # Backend URL (used by jobs for callbacks)
      BACKEND_URL: http://backend:3001
      # Note: Dockerfile defines NESTJS_API_URL but code uses BACKEND_URL
      # Setting both for compatibility
      NESTJS_API_URL: http://backend:3001
    networks:
      - izzzi-network
    deploy:
      mode: replicated
      replicas: 1
      # Temporarily removed platform constraints to allow deployment
      # placement:
      #   constraints:
      #     - node.platform.os == linux
      #     - node.platform.arch == amd64
      update_config:
        parallelism: 1
        delay: 10s
        failure_action: rollback
        order: start-first
      rollback_config:
        parallelism: 1
        delay: 10s
      restart_policy:
        condition: on-failure
        delay: 5s
        max_attempts: 3
      labels:
        - "traefik.enable=true"
        - "traefik.http.routers.ai-api.rule=Host(`ai.{{ domain }}`)"
        - "traefik.http.routers.ai-api.entrypoints=websecure"
        - "traefik.http.routers.ai-api.tls.certresolver=letsencrypt"
        - "traefik.http.services.ai-api.loadbalancer.server.port=8000"
        - "traefik.http.services.ai-api.loadbalancer.healthcheck.path=/health"
        - "traefik.http.services.ai-api.loadbalancer.healthcheck.interval=30s"
      resources:
        limits:
          cpus: "1.0"
          memory: 1G
        reservations:
          cpus: "0.5"
          memory: 512M
    healthcheck:
      test: ["CMD-SHELL", "python -c 'import urllib.request; urllib.request.urlopen(\"http://localhost:8000/health\")' || exit 1"]
      interval: 30s
      timeout: 10s
      retries: 5
      start_period: 60s

  # ============================================
  # CELERY WORKER - Background Tasks
  # ============================================
  celery-worker:
    image: {{ docker_registry }}/izzzi-ai:{{ image_tag | default('latest') }}
    command: ["/bin/sh", "-c", "celery -A src.infrastructure.jobs.celery_app worker --loglevel=info --pool=solo"]
    environment:
      ENVIRONMENT: production
      DEBUG: "false"
      LOG_LEVEL: INFO
      RUN_MIGRATIONS: "false"
      DATABASE_URL: "postgresql+asyncpg://izzzi_admin:Nadmer12%2C12%21@postgres:5432/izzzi"
      DATABASE_POOL_SIZE: "10"
      DATABASE_MAX_OVERFLOW: "5"
      JWT_SECRET: dGTTzsrUipsLtglTFe5a6yC43wrHYHSqUj3YCgBista9GQYXPaw0yvV4nLTF/1vN
      JWT_ALGORITHM: HS256
      OPENAI_API_KEY: {{ lookup('env', 'OPENAI_API_KEY') | default('sk-placeholder', true) }}
      OPENAI_MODEL: gpt-4-turbo-preview
      EMBEDDING_MODEL: text-embedding-3-small
      REDIS_URL: redis://redis:6379/1
      CELERY_BROKER_URL: redis://redis:6379/2
      CELERY_RESULT_BACKEND: redis://redis:6379/3
      BACKEND_URL: http://backend:3001
      NESTJS_API_URL: http://backend:3001
      API_V1_PREFIX: /api/v1
      SERVICE_NAME: izzzi-celery-worker
      SERVICE_PORT: "8000"
      PATH: /root/.local/bin:/usr/local/bin:/usr/bin:/bin
    networks:
      - izzzi-network
    deploy:
      mode: replicated
      replicas: 1
      # Temporarily removed platform constraints to allow deployment
      # placement:
      #   constraints:
      #     - node.platform.os == linux
      #     - node.platform.arch == amd64
      update_config:
        parallelism: 1
        delay: 10s
        failure_action: rollback
      restart_policy:
        condition: on-failure
        delay: 5s
        max_attempts: 3
      resources:
        limits:
          cpus: "0.5"
          memory: 640M
        reservations:
          cpus: "0.25"
          memory: 384M

  # ============================================
  # CELERY BEAT - Scheduled Tasks
  # ============================================
  celery-beat:
    image: {{ docker_registry }}/izzzi-ai:{{ image_tag | default('latest') }}
    command: ["/bin/sh", "-c", "celery -A src.infrastructure.jobs.celery_app beat --loglevel=info"]
    environment:
      ENVIRONMENT: production
      DEBUG: "false"
      LOG_LEVEL: INFO
      RUN_MIGRATIONS: "false"
      DATABASE_URL: "postgresql+asyncpg://izzzi_admin:Nadmer12%2C12%21@postgres:5432/izzzi"
      DATABASE_POOL_SIZE: "10"
      DATABASE_MAX_OVERFLOW: "5"
      JWT_SECRET: dGTTzsrUipsLtglTFe5a6yC43wrHYHSqUj3YCgBista9GQYXPaw0yvV4nLTF/1vN
      JWT_ALGORITHM: HS256
      OPENAI_API_KEY: {{ lookup('env', 'OPENAI_API_KEY') | default('sk-placeholder', true) }}
      OPENAI_MODEL: gpt-4-turbo-preview
      EMBEDDING_MODEL: text-embedding-3-small
      REDIS_URL: redis://redis:6379/1
      CELERY_BROKER_URL: redis://redis:6379/2
      CELERY_RESULT_BACKEND: redis://redis:6379/3
      BACKEND_URL: http://backend:3001
      API_V1_PREFIX: /api/v1
      SERVICE_NAME: izzzi-celery-beat
      SERVICE_PORT: "8000"
      PATH: /root/.local/bin:/usr/local/bin:/usr/bin:/bin
    networks:
      - izzzi-network
    deploy:
      mode: replicated
      replicas: 1
      # Temporarily removed platform constraints to allow deployment
      # placement:
      #   constraints:
      #     - node.platform.os == linux
      #     - node.platform.arch == amd64
      restart_policy:
        condition: on-failure
        delay: 5s
        max_attempts: 3
      resources:
        limits:
          cpus: "0.25"
          memory: 512M
        reservations:
          cpus: "0.15"
          memory: 256M

# ============================================
# VOLUMES
# ============================================
volumes:
  traefik_letsencrypt:
    driver: local
  postgres_data:
    driver: local
  redis_data:
    driver: local

# ============================================
# NETWORKS
# ============================================
networks:
  izzzi-network:
    driver: overlay
    attachable: true

