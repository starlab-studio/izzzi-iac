# IZZZI Environment Configuration - Generated by Ansible
# Environment: {{ environment }}
# Domain: {{ domain }}
# Generated: {{ ansible_date_time.iso8601 }}

# Domain Configuration
DOMAIN={{ domain }}
ACME_EMAIL=admin@{{ domain }}

# Docker Registry & Image Tag
DOCKER_REGISTRY={{ docker_registry }}
IMAGE_TAG={{ image_tag }}

# Database Configuration
DATABASE_NAME={{ database_name }}
DATABASE_HOST={{ database_host }}
DATABASE_PORT={{ database_port }}
DATABASE_USER={{ lookup('env', 'DB_USER') | default('izzzi_admin', true) }}
DATABASE_PASSWORD={{ lookup('env', 'DB_PASSWORD') | default('Nadmer12,12!', true) }}

# Redis Configuration
REDIS_HOST={{ redis_host }}
REDIS_PORT={{ redis_port }}

# Traefik Dashboard Auth (htpasswd format)
# Generate with: htpasswd -nb admin password
TRAEFIK_DASHBOARD_AUTH={{ lookup('env', 'TRAEFIK_DASHBOARD_AUTH') | default('admin:$apr1$xyz', true) }}

# Frontend Environment Variables
STRIPE_PUBLISHABLE_KEY={{ lookup('env', 'STRIPE_PUBLISHABLE_KEY') | default('', true) }}
POSTHOG_KEY={{ lookup('env', 'POSTHOG_KEY') | default('', true) }}

# Backend Environment Variables
AWS_REGION={{ lookup('env', 'AWS_REGION') | default('eu-west-3', true) }}
AWS_ACCESS_KEY_ID={{ lookup('env', 'AWS_ACCESS_KEY_ID') | default('DO007CPECYTU2UT9QBW3', true) }}
AWS_SECRET_ACCESS_KEY={{ lookup('env', 'AWS_SECRET_ACCESS_KEY') | default('X7lHW1RuN0OuMMMfSPjQqskcNhCKIl8NHqjZ9e/DaEA', true) }}
AWS_S3_BUCKET={{ lookup('env', 'AWS_S3_BUCKET') | default('izzzi-storage', true) }}
AWS_COGNITO_USER_POOL_CLIENT_ID={{ lookup('env', 'AWS_COGNITO_USER_POOL_CLIENT_ID') | default('', true) }}
AWS_COGNITO_USER_POOL_ID={{ lookup('env', 'AWS_COGNITO_USER_POOL_ID') | default('', true) }}
GOOGLE_CLIENT_ID={{ lookup('env', 'GOOGLE_CLIENT_ID') | default('', true) }}

# Celery Services Environment Variables
# Database URL for Celery (password URL-encoded: comma=%2C, exclamation=%21)
{%- set db_user = lookup('env', 'DB_USER') | default('izzzi_admin', true) -%}
{%- set db_password = lookup('env', 'DB_PASSWORD') | default('Nadmer12,12!', true) -%}
{%- set db_password_encoded = db_password | replace(',', '%2C') | replace('!', '%21') -%}
CELERY_DATABASE_URL=postgresql+asyncpg://{{ db_user }}:{{ db_password_encoded }}@postgres:5432/{{ database_name }}
CELERY_API_V1_PREFIX=/api/v1
CELERY_SERVICE_NAME_WORKER=izzzi-celery-worker
CELERY_SERVICE_NAME_BEAT=izzzi-celery-beat
CELERY_SERVICE_PORT=8000

# Note: Secrets are managed via Docker secrets, not environment variables
# The following secrets must be created as Docker secrets:
# - db_user
# - db_password
# - jwt_secret
# - jwt_refresh_secret
# - openai_api_key
# - stripe_secret_key
# - stripe_webhook_secret
# - google_client_secret
# - brevo_api_key
# - aws_secret_access_key
# - cognito_client_secret
